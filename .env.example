# Copy this file to .env and adjust values as needed.

# Path where uploaded files are stored
UPLOAD_DIR=uploads

# Database connection string
# SQLite (default, good for development)
DATABASE_URL=sqlite:///./geo_api.db

# PostgreSQL example (recommended for production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/geo_db

# Max upload size in bytes (default 50 MB)
MAX_UPLOAD_SIZE=52428800
